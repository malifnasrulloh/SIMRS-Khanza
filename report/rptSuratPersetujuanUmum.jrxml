			</textField>
			<staticText>
				<reportElement positionType="Float" x="10" y="210" width="520" height="15" uuid="1177d9dc-7cc1-4789-ba5a-b5ef7c6f81ac"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="9" isBold="false"/>
				</textElement>
				<text><![CDATA[selaku pasien dengan ini menyatakan persetujuan :]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="10" y="230" width="520" height="13" uuid="a94d4fee-3002-49ea-b672-314a629cae47"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["1. PERSETUJUAN UNTUK PERAWATAN DAN PENGOBATAN"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="245" width="505" height="13" uuid="cbf98bb4-043f-4884-a458-ae7588a49081"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["a. Saya mengetahui bahwa saya memiliki kondisi yang membutuhkan perawatan medis. Saya mengizinkan dokter dan profesional kesehatan lainnya untuk melakukan prosedur diagnostik dan memberikan pengobatan medis seperti yang diperlukan dalam penilaian profesional mereka. Prosedur diagnostik dan perawatan medis termasuk terapi electrocardigarm, X-ray, tes darah, pemeriksaan laboratorium lainnya, terapi fisik, dan pemberian obat (kecuali yang membutuhkan persetujuan khusus/tertulis)."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="260" width="505" height="13" uuid="ad0431c9-b5e8-484b-aab5-ce99ce2daf2d"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["b. Saya sadar bahwa praktik kedokteran dan bedah bukanlah ilmu pasti dan saya mengakui bahwa tidak ada jaminan atas hasil apa pun terhadap perawatan, prosedur, atau pemeriksaan apa pun yang dilakukan kepada saya."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="275" width="505" height="13" uuid="338d3d6b-18da-42e2-9506-e025632e6317"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["c. Saya mengerti dan memahami bahwa:"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="40" y="290" width="490" height="13" uuid="7559dadf-fea6-4be4-9ad2-4fc12d603e5a"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["1. Saya memiliki hak untuk mengajukan pertanyaan tentang pengobatan yang diusulkan termasuk identitas setiap orang yang memberikan atau mengamati pengobatan."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="40" y="305" width="490" height="13" uuid="6b00f61e-de17-4b1e-bd44-a43ffaf02820"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["2. Saya memiliki hak untuk menyetujui atau menolak persetujuan untuk setiap prosedur terapi."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="40" y="320" width="490" height="13" uuid="8aa2a70c-a924-4b5a-b298-c3b2cb64567e"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["3. Saya mengerti bahwa ada staf medis rumah sakit bukan karyawan (staf tamu) yang telah diberikan hak untuk menggunakan fasilitas untuk perawatan dan pengobatan pasien mereka."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="335" width="505" height="13" uuid="68fbbdbd-9982-47a3-ac7c-102045df0291"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["d. Persetujuan yang saya berikan tidak termasuk persetujuan untuk prosedur/tindakan invasif atau tindakan yang memiliki risiko tinggi."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="350" width="505" height="13" uuid="0253769c-2cbe-429f-a92a-a55479290c30"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["e. Jika saya memutuskan untuk menghentikan perawatan medis untuk diri saya sendiri, saya memahami dan menyadari bahwa " + $P{namars} + " atau dokter dan profesional pemberi asuhan tidak bertanggung jawab atas hasil yang merugikan saya."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="10" y="370" width="520" height="13" uuid="87c4ed48-99bc-4604-92d1-85aa4a25cd08"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["2. BARANG MILIK PASIEN"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="385" width="505" height="13" uuid="dc3a69f6-9b61-4bbd-9916-c14b03d499ba"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memahami bahwa rumah sakit tidak bertanggung jawab atas semua kehilangan barang-barang milik saya dan saya pribadi bertanggung jawab atas barang berharga yang saya miliki termasuk uang, perhiasan, buku, cek, kartu kredit, handphone, atau barang berharga lainnya."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="10" y="405" width="520" height="13" uuid="25cff3a7-515f-438b-b0d3-a72a4a82e431"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["3. PERSETUJUAN PELEPASAN INFORMASI"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="420" width="505" height="13" uuid="4ddd514f-3b23-45ab-b947-0562e7fe883c"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memahami informasi yang ada di dalam diri saya termasuk diagnosis, hasil laboratorium, dan hasil tes diagnosis yang akan digunakan untuk perawatan medis, " + $P{namars} + " akan menjamin kerahasiaannya. Saya memberi wewenang kepada " + $P{namars} + " untuk memberikan informasi tentang diagnosis, hasil pelayanan, dan pengobatan saya kepada anggota keluarga saya, tersebut:"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="40" y="435" width="490" height="13" uuid="b6293773-7ba5-4357-92f8-a8b9d52a62b2"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["1. " + ($F{penerima_nama_1} == null || $F{penerima_nama_1}.equals("") ? "-" : $F{penerima_nama_1} + " (" + $F{penerima_hubungan_1} + ")")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="40" y="450" width="490" height="13" uuid="4975949d-323e-4b8b-886d-a7fceac5eb8e"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["2. " + ($F{penerima_nama_2} == null || $F{penerima_nama_2}.equals("") ? "-" : $F{penerima_nama_2} + " (" + $F{penerima_hubungan_2} + ")")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="40" y="465" width="490" height="13" uuid="16b299f7-035b-43ce-b9a1-4789a2567a14"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["3. " + ($F{penerima_nama_3} == null || $F{penerima_nama_3}.equals("") ? "-" : $F{penerima_nama_3} + " (" + $F{penerima_hubungan_3} + ")")]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="10" y="485" width="520" height="13" uuid="6efa851a-87c6-4120-95cd-54936be27590"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["4. HAK DAN TANGGUNG JAWAB PASIEN"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="500" width="505" height="13" uuid="8490799f-0edf-4938-8dde-d3f7f27af74a"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memiliki hak untuk mengambil bagian dalam keputusan mengenai penyakit saya dan dalam hal perawatan medis dan rencana pengobatan. Saya telah mendapat informasi tentang \"Hak dan Kewajiban Pasien\" di " + $P{namars} + " melalui leaflet dan banner yang disediakan petugas."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="10" y="520" width="520" height="13" uuid="4538ada4-9b0a-4db3-afcb-39d63ba2a8ff"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["5. INFORMASI RAWAT JALAN"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="535" width="505" height="13" uuid="df912700-d509-4eb0-8416-e2d2b99db5f6"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya telah menerima informasi tentang peraturan yang telah diberlakukan di rumah sakit dan saya beserta keluarga bersedia untuk mematuhinya, termasuk mematuhi jam berkunjung pasien sesuai dengan aturan di rumah sakit."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="10" y="555" width="520" height="13" uuid="e5705b15-927d-4bc3-b8e9-7bb0c481a29a"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["6. INFORMASI BIAYA"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="25" y="570" width="505" height="13" uuid="6e00e6bd-fdb7-451e-ab8f-a646803288e6"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="9" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya memahami tentang informasi biaya pengobatan atau biaya tindakan yang dijelaskan oleh petugas rumah sakit. Apabila saya adalah pasien BPJS/asuransi, saya bersedia mematuhi peraturan yang ditentukan oleh pihak penjamin untuk mendapatkan pelayanan kesehatan."]]></textFieldExpression>
			</textField>
		</band>
		<band height="820">
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="10" width="553" height="13" uuid="e6ed1526-d915-4e23-820c-47fb0f941f23"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="true"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["KETENTUAN YANG WAJIB DITAATI WAKTU RAWAT JALAN DI " + $P{namars}.toUpperCase()]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="25" width="543" height="13" uuid="5dd038e4-9593-4c68-a06e-55d6d5a95bb0"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["1. Dilarang membawa barang-barang berharga/perhiasan."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="40" width="543" height="13" uuid="384667cb-c5f1-41f7-9cd5-2bdb03351749"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["2. Dilarang membawa senjata tajam/senjata api."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="55" width="543" height="13" uuid="5a257f43-b575-44c6-a108-dc4fa5d6a772"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["3. Jam Kunjungan:"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="25" y="70" width="528" height="13" uuid="1a8afdc9-1e97-4be3-baf5-e0bc376ada78"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["   a. Poli Bedah: 08.00 - 11.00 & 19.00 – 21.00"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="25" y="85" width="528" height="13" uuid="57d5326e-ca9c-4635-8e96-c4d014441864"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["   b. Poli Penyakit Dalam: 18.00 – 19.00"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="100" width="543" height="13" uuid="4aade9ea-530b-49ee-9337-5ff37ab619a1"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["4. Dilarang merokok di luar/di dalam ruangan (lingkungan rumah sakit)."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="115" width="543" height="13" uuid="e7c432d7-5f49-47b0-985e-9cc1f6147745"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["5. Dilarang memindahkan alat, mengubah-ubah, dan membawa pulang alat perawatan yang ada."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="130" width="543" height="13" uuid="41c1f40d-bec6-4f6a-ac65-e68c0d1e90ec"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["6. Dilarang melakukan tindakan kriminal."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="145" width="543" height="13" uuid="6915cd09-258c-4e75-bc5b-ac84014c340d"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["7. Dilarang menggunakan/mengedarkan narkoba."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="160" width="543" height="13" uuid="93024bc9-dadf-4e75-a0bf-0bb84db72b5c"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["8. Dilarang melakukan tindak asusila."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="175" width="543" height="13" uuid="6c9d8ef0-96b4-412e-9acf-cc2536ad0785"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["9. Untuk menjaga privasi, dilarang mengambil gambar, merekam suara maupun video terhadap pelayanan yang diberikan kepada pasien tanpa izin dari pihak rumah sakit."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="190" width="543" height="13" uuid="6a5b77d0-d1be-4803-a5f7-7bfa2d26a938"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["10. Pasien yang menggunakan BPJS/Asuransi, jika disarankan untuk operasi, maka waktu berunding maksimal 3x24 jam setelah melakukan konsultasi dokter."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="205" width="543" height="13" uuid="da66581c-9444-4c8d-8d33-51e52df2b49d"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["11. Pasien diwajibkan mematuhi segala regulasi " + $P{namars} + " demi keamanan dan keselamatan (safety) bersama."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="230" width="553" height="13" uuid="375b571e-92d4-45bf-9298-b5b994286bb2"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="true"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["HAK PASIEN"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="245" width="543" height="13" uuid="2d51fd9b-fa28-4182-bbd5-0352c793bc80"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["1. Pasien berhak memperoleh informasi mengenai tata tertib dan peraturan yang berlaku di rumah sakit."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="260" width="543" height="13" uuid="89b5edb1-b2c9-431e-9b93-1c189e623f93"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["2. Pasien berhak memperoleh informasi tentang hak dan kewajiban pasien."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="275" width="543" height="13" uuid="5ea77e18-d799-4fa6-9ad9-85b1b46f04d9"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["3. Pasien berhak memperoleh pelayanan yang manusiawi, adil, jujur, tanpa diskriminasi."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="290" width="543" height="13" uuid="09391df9-58c9-433d-b3b0-0a3c9d1711c2"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["4. Pasien berhak memperoleh layanan kesehatan yang bermutu sesuai dengan standar profesi dan standar prosedur operasional."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="305" width="543" height="13" uuid="54a99dca-5ab3-4eaf-bc23-7f25bd7626fc"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["5. Pasien berhak memperoleh layanan yang efektif dan efisien sehingga pasien terhindar dari kerugian fisik dan materi."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="320" width="543" height="13" uuid="0c2c0574-8ec4-43e5-92d8-dac222dca82b"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["6. Pasien berhak mengajukan pengaduan atas kualitas pelayanan yang didapatkan."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="335" width="543" height="13" uuid="b037ccbf-eb21-426a-9db2-650571f69160"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["7. Pasien berhak memilih dokter dan kelas perawatan sesuai dengan keinginan dan ketentuan yang berlaku di rumah sakit."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="350" width="543" height="13" uuid="90f654c5-9abe-4b60-9e77-8212f597db1b"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["8. Pasien berhak meminta konsultasi tentang penyakit yang dideritanya kepada dokter lain yang mempunyai Surat Izin Praktik (SIP) baik di dalam maupun di luar rumah sakit."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="365" width="543" height="13" uuid="c32bbbff-1191-4e9c-847a-f215f861b3dc"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["9. Pasien berhak mendapat privasi dan kerahasiaan penyakit yang diderita termasuk data-data medisnya."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="380" width="543" height="13" uuid="b4c1f007-2593-45de-978c-1ffda8f069f1"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["10. Pasien berhak mendapat informasi yang meliputi diagnosis dan tata cara tindakan medis, tujuan tindakan medis, alternatif tindakan, risiko, komplikasi yang mungkin terjadi, dan prognosis terhadap tindakan yang dilakukan serta perkiraan biaya pengobatan."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="395" width="543" height="13" uuid="fd8f5535-23aa-40a5-b0b6-24e008f12521"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["11. Pasien berhak memberikan persetujuan atau menolak atas tindakan yang akan dilakukan oleh tenaga kesehatan terhadap penyakit yang dideritanya."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="410" width="543" height="13" uuid="366c6d6f-df21-43d4-a8f0-7b7a49eb4aff"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["12. Pasien berhak didampingi keluarganya dalam keadaan kritis."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="425" width="543" height="13" uuid="fee85309-6718-4548-93f5-e059414350fe"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["13. Pasien berhak menjalankan ibadah sesuai agama atau kepercayaan yang dianutnya selama itu tidak mengganggu pasien lain."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="440" width="543" height="13" uuid="cf35cd09-4bcf-4a3d-b494-aaff0df31599"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["14. Pasien berhak memperoleh keamanan dan keselamatan dirinya selama dalam perawatan di rumah sakit."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="455" width="543" height="13" uuid="e26e9eec-83b0-4d23-8b71-137ac2560a33"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["15. Pasien berhak mengajukan usul, saran, perbaikan atas perilaku rumah sakit terhadap dirinya."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="470" width="543" height="13" uuid="4f6484e3-0978-4f9e-a088-8182e98cb886"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["16. Pasien berhak menolak pelayanan bimbingan rohani yang tidak sesuai dengan agama dan kepercayaan yang dianutnya."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="485" width="543" height="13" uuid="95c826a9-8652-470a-affe-6b8f491ec525"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["17. Pasien berhak menggugat dan/atau menuntut rumah sakit apabila rumah sakit diduga memberikan pelayanan tidak sesuai dengan standar baik secara perdata maupun pidana."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="500" width="543" height="13" uuid="5bd88b17-d306-4c1e-8b54-caf9a1c00e82"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["18. Pasien berhak mengeluhkan pelayanan rumah sakit yang tidak sesuai dengan standar pelayanan melalui media cetak atau elektronik sesuai dengan ketentuan peraturan perundang-undangan."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="525" width="553" height="13" uuid="8fa8c120-2a12-4fdf-92fc-629f17e6d729"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="true"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["KEWAJIBAN PASIEN"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="540" width="543" height="13" uuid="43533098-00a6-4db6-b328-589010bdf015"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["1. Mematuhi peraturan yang berlaku di rumah sakit."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="555" width="543" height="13" uuid="c28ab51c-1a86-45f6-98aa-9d4f14857882"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["2. Menggunakan fasilitas rumah sakit secara bertanggung jawab."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="570" width="543" height="13" uuid="392760b8-6639-41b0-8488-9052dc9135b6"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["3. Menghormati hak pasien lain, pengunjung, dan hak tenaga kesehatan serta petugas lainnya yang bekerja di rumah sakit."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="585" width="543" height="13" uuid="8fe53e77-a813-4f99-b128-01f781572280"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["4. Memberikan informasi yang jujur, lengkap, dan akurat sesuai dengan kemampuan dan pengetahuannya tentang masalah kesehatannya."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="600" width="543" height="13" uuid="7ce5ca95-b2c4-43fb-9b90-a221131607db"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["5. Memberikan informasi mengenai kemampuan finansial dan jaminan kesehatan yang dimilikinya."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="615" width="543" height="13" uuid="c46d1860-964c-4941-874b-40346b133037"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["6. Mematuhi rencana terapi yang direkomendasikan oleh tenaga kesehatan di rumah sakit dan disetujui oleh pasien yang bersangkutan setelah mendapatkan penjelasan sesuai dengan ketentuan peraturan perundang-undangan."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="630" width="543" height="13" uuid="2344d727-cfc6-4475-bdaa-0c3a3c8c3e1d"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["7. Menerima segala konsekuensi atas keputusan pribadinya untuk menolak rencana terapi yang direkomendasikan oleh tenaga kesehatan dan/atau tidak mematuhi petunjuk yang diberikan oleh tenaga kesehatan untuk penyembuhan penyakit atau masalah kesehatannya."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="10" y="645" width="543" height="13" uuid="99dc7e76-c02c-4137-8b81-96f57829a4a4"/>
                <textElement textAlignment="Justified">
                    <font fontName="Tahoma" size="9" isBold="false"/>
                    <paragraph lineSpacing="Single"/>
                </textElement>
                <textFieldExpression><![CDATA["8. Meminta imbalan jasa atas pelayanan yang diterima."]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="350" y="680" width="200" height="12" uuid="fa4c3fbd-d51d-43b2-b765-e9599fd047bf"/>
                <textElement textAlignment="Center"><font fontName="Tahoma" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{kotars}+", "+new SimpleDateFormat("dd-MM-yyyy", new
java.util.Locale("id")).format($F{tanggal})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement positionType="Float" x="0" y="680" width="200" height="12" uuid="ae73eda0-bd1d-4bef-91ef-d35c764b9e32"/>
                <textElement textAlignment="Center"><font fontName="Tahoma" size="9"/></textElement>
                <text><![CDATA[Petugas Pendaftaran]]></text>
            </staticText>
            <staticText>
                <reportElement positionType="Float" x="350" y="695" width="200" height="12" uuid="de44ffe2-de84-4e0e-b9b8-4776c4d99d30"/>
                <textElement textAlignment="Center"><font fontName="Tahoma" size="9"/></textElement>
                <text><![CDATA[Pasien / Wali Pasien]]></text>
            </staticText>
            <componentElement>
                <reportElement positionType="Float" x="2" y="710" width="196" height="80" uuid="adc21123-e9d1-44d6-8f89-28f32bf8f601"/>
                <jr:QRCode xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd">
