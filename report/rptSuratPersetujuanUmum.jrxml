                <imageExpression><![CDATA[$P{photo}]]></imageExpression>
            </image>
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="795" width="200" height="12" uuid="bdd0c4e3-10c0-4411-a0a6-6ea37989884c"/>
                <textElement textAlignment="Center"><font fontName="Tahoma" size="9" isUnderline="false"/></textElement>
                <textFieldExpression><![CDATA["("+$F{nama}+")"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
